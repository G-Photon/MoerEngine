{
  "version": 1,
  "groups": [
    {
      "name": "editor", "cpp_type": "Editor",
      "fields": [
        {"name": "width", "type": "uint32", "default": 1920},
        {"name": "height", "type": "uint32", "default": 1080},
        {"name": "fullscreen", "type": "bool", "default": false},
        {"name": "vsync", "type": "bool", "default": false},
        {"name": "lock_frame_rate", "type": "bool", "default": false},
        {"name": "fps", "type": "uint32", "default": 60},
        {"name": "max_fps", "type": "uint32", "default": 170},
        {"name": "font_size", "type": "float", "default": 16.0, "template": 17.0},
        {"name": "preset_imgui_config_path", "type": "string", "default": "./asset/preset_imgui.ini"}
      ]
    },
    {
      "name": "engine", "cpp_type": "Engine",
      "groups": [
        {
          "name": "threading", "cpp_type": "Threading",
          "fields": [
            {"name": "render_thread", "type": "bool", "default": false},
            {"name": "profile_logging", "type": "bool", "default": false},
            {"name": "submission_batch_window", "type": "uint32", "default": 2,
             "comment": "Bounded RHI overlap. Runtime clamps to [1, 8]; aliased native queues use 1."},
            {"name": "max_frame_lag", "type": "uint32", "default": 0}
          ]
        },
        {
          "name": "profile_dump", "cpp_type": "ProfileDump",
          "fields": [
            {"name": "enabled", "type": "bool", "default": false,
             "comment": "Start an Engine-owned capture session at startup; it can be stopped and restarted."},
            {"name": "output_path", "type": "string", "default": "./profile/MoerProfile.mpd"},
            {"name": "replace_existing", "type": "bool", "default": true,
             "comment": "Replace the previous final capture only after the new capture closes successfully."}
          ]
        },
        {
          "name": "rhi", "cpp_type": "RHI",
          "fields": [
            {"name": "type", "type": "string", "default": "Not Specified", "template": "Vulkan",
             "comment": "Supported backend names include Vulkan and D3D12."},
            {"name": "api_version", "type": "string", "default": "1.3"},
            {"name": "max_frame_in_flight", "type": "uint32", "default": 3}
          ]
        },
        {
          "name": "render", "cpp_type": "Render",
          "fields": [
            {"name": "default_render_method", "type": "string", "default": "Raster",
             "comment": "Raster or Raytracing."}
          ],
          "groups": [
            {
              "name": "raster", "cpp_type": "Raster",
              "comment": "RDG compilation is mandatory; parallel recording changes CPU scheduling only.",
              "fields": [
                {"name": "enable_shadow", "type": "bool", "default": true},
                {"name": "low_quality_mode", "type": "bool", "default": false,
                 "comment": "Use SSAO, fewer/smaller CSM cascades and simplified FXAA on lower-end GPUs."},
                {"name": "render_graph_debug_dump", "type": "bool", "default": false},
                {"name": "render_graph_parallel_recording", "type": "bool", "default": false}
              ]
            },
            {
              "name": "raytracing", "cpp_type": "Raytracing",
              "fields": [
                {"name": "render_graph_debug_dump", "type": "bool", "default": false},
                {"name": "render_graph_parallel_recording", "type": "bool", "default": false}
              ]
            }
          ]
        },
        {
          "name": "scene", "cpp_type": "Scene",
          "fields": [
            {"name": "scene_path", "type": "string", "default": "./asset/scenes/sponza/Sponza.gltf",
             "comment": "Absolute paths are supported; escape backslashes in double-quoted TOML strings."},
            {"name": "enable_cache", "type": "bool", "default": true},
            {"name": "material_info_log_lines", "type": "int", "default": -1, "template": 20,
             "comment": "Maximum material information lines during loading; -1 prints every line."}
          ]
        },
        {
          "name": "remote", "cpp_type": "Remote",
          "fields": [
            {"name": "enable", "type": "bool", "default": false, "template": true},
            {"name": "bind_address", "type": "string", "default": "127.0.0.1"},
            {"name": "http_port", "type": "uint32", "default": 18080},
            {"name": "websocket_port", "type": "uint32", "default": 18081}
          ]
        }
      ]
    }
  ],
  "enums": {
    "EShadingMode": ["DEFAULT_PBR", "DEBUG"],
    "EBrdfNdfMode": ["BECKMANN", "GGX", "GTR2", "GTR1"],
    "EBrdfGMode": ["G_SCHLICK", "VIS_UE4", "VIS_UNITY", "VIS_FILAMENT", "VIS_RESPAWN"],
    "EAaMode": ["NONE", "FXAA_SIMPLIFIED", "FXAA_QUALITY", "SMAA_1X", "SMAA_T2X"],
    "EAoMode": ["NONE", "SSAO", "SSAO_AO_ONLY", "RTAO", "RTAO_AO_ONLY", "SSDO", "SSDO_AO_ONLY", "LINEARIZED_DEPTH_DIV_10"],
    "EDenoiserMode": ["NONE", "BILATERAL_FILTER"],
    "ERtaoSampleMode": ["UNIFORM", "COSINE_WEIGHTED"],
    "EShadowMapMode": ["NONE", "POINT_CUBE", "CSM", "CSM_AUTO"],
    "EUpsampleMode": ["None", "BILINEAR", "DEPTH"],
    "EAnitiAliasMode": ["EAA_TAA"],
    "EOutputTexture": ["EOT_LDR", "EOT_HDR"],
    "EJitter": ["MSAA", "Halton", "R2", "WhiteNoise"],
    "Render::EFinalColor": ["EFC_SceneColor", "EFC_DI", "EFC_EMISSIVE", "EFC_DIFFUSE", "EFC_SPECULAR", "EFC_NORMAL", "EFC_VIEW_DEPTH", "EFC_DEPTH", "EFC_MOTION", "EFC_GRID", "EFC_MATERIAL", "EFC_INSTANCE", "EFC_POSITION", "EFC_CUSTOM"]
